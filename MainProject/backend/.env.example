# Copy to backend/.env and fill in. This file is read ONLY by the server; never put keys in the frontend.

# --- Database ---------------------------------------------------------------
# PostgreSQL / Supabase (recommended):
# DATABASE_URL=postgresql+psycopg2://interview:interview@localhost:5432/interview_sim
# Supabase: Project settings -> Database -> Connection string (URI), with the +psycopg2 driver:
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Zero-setup local default:
DATABASE_URL=sqlite:///./interview_sim.db

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- LLM --------------------------------------------------------------------
# anthropic | openai | demo   (no key => the app runs in clearly-labelled DEMO MODE)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible endpoint (OpenAI, Azure-compatible gateways, local servers):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=45

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_FOLLOWUPS_PER_TOPIC=2
